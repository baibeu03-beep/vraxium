            width: 60px;
            height: 60px;
            object-fit: contain;
          }

          .icon-placeholder {
            width: 60px;
            height: 60px;
            background: #CCC;
            border-radius: 0;
          }
        }

        .card-content-area {
          flex: 1;
          display: flex;
          flex-direction: column;
          margin-left: -3px;

          .card-title-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
            flex-wrap: wrap;

            .title-icon {
              width: 16px;
              height: 16px;
              object-fit: contain;
            }

            .card-title {
              font-size: 14px;
              font-weight: 500;
              color: #FFEC8F;
              font-family: 'Pretendard', sans-serif;
            }

            .verified-icon {
              width: 14px;
              height: 14px;
              object-fit: contain;
