      .work-ability-card {
        position: relative;
        background: #232323;
        border-radius: 20px;
        overflow: visible;
        display: flex;
        flex-direction: row;
        max-width: 71%;
        padding: 14px;
        gap: 12px;

        .card-icon-area {
          width: 60px;
          height: 60px;
          flex-shrink: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          align-self: flex-start;
          margin-top: 2px;

