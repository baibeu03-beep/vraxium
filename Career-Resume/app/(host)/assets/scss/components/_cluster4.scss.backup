                  img.star {
                    width: 14px;
                    height: 14px;
                    object-fit: contain;
                  }

                  .star.half {
                    position: relative;
                    width: 14px;
                    height: 14px;
                    display: inline-block;

                    img {
                      position: absolute;
                      top: 0;
                      left: 0;
