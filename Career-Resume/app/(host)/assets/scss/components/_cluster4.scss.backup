            }

            .verified-text {
              font-size: 12px;
              color: rgba(255, 255, 255, 0.6);
              font-family: 'Pretendard', sans-serif;
            }

            .code-tag {
              font-size: 14px;
              color: #FFEC8F;
              font-family: 'Pretendard', sans-serif;
            }

            .info-tag {
              font-size: 15px;
              color: #FAAB07;
              background: rgba(250, 171, 7, 0.1);
              padding: 5px 8px 3px 8px;
              border-radius: 4px;
              font-family: 'Pretendard', sans-serif;
              font-weight: 400;
              white-space: nowrap;
              line-height: 1;
            }
          }

          .main-desc {
            font-size: 14px;
            color: #fff;
            line-height: 1.6;
            font-family: 'Pretendard', sans-serif;
            font-weight: 500;
            margin: 0 0 12px 0;
          }

          .sub-title-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;

            .sub-icon {
              width: 16px;
              height: 16px;
              object-fit: contain;
            }

            .sub-label {
              font-size: 14px;
              font-weight: 500;
              color: #FFEC8F;
              font-family: 'Pretendard', sans-serif;
            }
          }

          .sub-desc {
            font-size: 14px;
            color: #fff;
            line-height: 1.5;
            font-family: 'Pretendard', sans-serif;
            font-weight: 400;
            display: inline-flex;
            align-items: center;
            white-space: nowrap;

            .card-arrow {
              width: 16px;
              height: 16px;
              object-fit: contain;
              flex-shrink: 0;
              margin-left: 4px;
            }
          }
        }

        .status-badge {
          position: absolute;
          top: -20px;
          right: 10px;
          z-index: 10;

          img {
            width: 55px;
            height: 55px;
            object-fit: contain;
          }
        }
      }

      .character-image {
        position: absolute;
        right: 0;
        bottom: -60px;
        width: 326px;
        height: 314px;
        overflow: hidden;
        opacity: 0.6;

        &::after {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          bottom: 0;
          width: 80px;
          background: linear-gradient(to left, transparent, #000);
          pointer-events: none;
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }

