# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Deploy scope (operating | qa). Determines the population/QA-overlay scope for the WHOLE deploy.
#   - operating (default / unset): real users only. qa_* tables are never read. Identical to legacy behavior.
#   - qa: only test_user_markers users can access; all screens show test-marker data + qa_* overlay.
# NEXT_PUBLIC_APP_ENV is read by both client and server (Next inlines NEXT_PUBLIC_* at build time),
# so each deploy is a separate build pinned to one scope (operating/QA data never mix on one screen).
# NEXT_PUBLIC_DEPLOY_ENV is accepted as an alias. The old ?mode=test URL toggle is deprecated/removed.
NEXT_PUBLIC_APP_ENV=operating
# APP_ENV mirrors NEXT_PUBLIC_APP_ENV for any server-only consumers (optional).
APP_ENV=operating

# Backend API URL
NEXT_PUBLIC_API_URL=http://your-backend-api.com

# Admin API base URL.
# Local development: leave empty to auto-detect vraxium-admin on localhost:3000, 3001, or 3002.
# Vercel/production: required. Set to the deployed vraxium-admin origin, without a trailing slash.
# Example: ADMIN_API_BASE_URL=https://vraxium-admin.vercel.app
ADMIN_API_BASE_URL=

# Admin API server-to-server auth. Sent as x-internal-api-key by customer app API routes.
INTERNAL_API_KEY=your-internal-api-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Demo/test user mode. Production defaults to disabled unless explicitly enabled.
# ENABLE_DEMO_MODE=true

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord OAuth (Optional)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
