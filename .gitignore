# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
nftg/
test/
nul
notepad .gitignore
!vendor/
!vendor/nftg/
!vendor/nftg/**

# playwright-mcp dev artifacts (auto-generated console/page snapshots)
.playwright-mcp/
vraxium-admin/

# one-off diagnostic / verification / measurement scripts (throwaway)
scripts/diag_*
scripts/verify_*
scripts/measure_*
scripts/shot_*
scripts/pw-*
scripts/normalize_*
scripts/check_prod_deploy.mjs

# generated artifacts (screenshots, dev logs)
scripts/*.png
*.log
